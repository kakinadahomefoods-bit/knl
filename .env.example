# Server-only. Never expose these to the browser.
MONGODB_URI=
ADMIN_SESSION_SECRET=
NEXT_PUBLIC_SITE_URL=
# Local setup script only; never expose to the browser.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_CURRENT_PASSWORD=

# Cloudinary (server-side uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay — leave blank locally to use the clearly-labelled development simulation
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Delhivery — leave blank locally to use the clearly-labelled development simulation
# Server-only. Never expose these to the browser or commit real values.
DELHIVERY_API_TOKEN=
DELHIVERY_API_BASE_URL=
DELHIVERY_PICKUP_NAME=
# Pickup PIN used for quotes and rate fallback (defaults to the studio PIN 518502)
DELHIVERY_PICKUP_PIN=
# Optional: exact label API URL from your Delhivery One developer portal. Use {awb} placeholder.
DELHIVERY_LABEL_API_URL=

# Shipping rules (admin Settings values override these when present)
FREE_SHIPPING_THRESHOLD=
FLAT_SHIPPING_FEE=
# Packed-weight defaults used for quotes/manifest when a product has no dimensions
SHIPPING_DEFAULT_WEIGHT_GRAMS=
SHIPPING_DEFAULT_LENGTH_CM=
SHIPPING_DEFAULT_BREADTH_CM=
SHIPPING_DEFAULT_HEIGHT_CM=
SHIPPING_VOLUMETRIC_DIVISOR=

# OPTIONAL APPROVED FALLBACK — OFF by default. Not a Delhivery quote.
# Set to true only after approving a configurable weight/PIN based rate card.
SHIPPING_RATE_FALLBACK=
# JSON rate card: {"defaultFee":80,"slabs":[{"upToGrams":500,"fee":70}],"localPrefixLength":2,"localMultiplier":0.85,"pinPrefixMultipliers":[{"prefix":"11","multiplier":1.1}]}
SHIPPING_RATE_CARD=

# LIVE RATE API — do not enable without the account-specific endpoint/schema from
# Delhivery One > Developer Portal > "Calculate Shipping Cost". No URL is invented here.
DELHIVERY_RATE_API_ENABLED=

# Email provider (Resend-compatible). Leave blank: no email will be sent or claimed.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
EMAIL_API_URL=

# Simulations are disabled automatically when NODE_ENV=production.
# Set to false to forbid them even in development.
ALLOW_DEV_SIMULATION=
CONTACT_EMAIL=
